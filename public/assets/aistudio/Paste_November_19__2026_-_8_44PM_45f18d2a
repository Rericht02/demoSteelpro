      const elDimTitle = document.getElementById('spDimTitle');
      const elDimSpecs = document.getElementById('spDimSpecs');
      const elFootnote = document.getElementById('spFootnote');
      const elWfPath = document.getElementById('wfPath');

      // Format angka desimal ke format Indonesia (koma)
      function formatID(num) {
        return num.toLocaleString('id-ID', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        });
      }

      // Fungsi utama kalkulasi kapasitas lentur balok WF
      function calculateBeam() {
        try {
          // Parse nilai profil: Zx | berat_kg_m | H | B | tw | tf
          const profParts = String(elProf.value).split('|');
          const zx = parseFloat(profParts[0]) || 196;
          const unitWeight = parseFloat(profParts[1]) || 21.3;
          const h = parseFloat(profParts[2]) || 200;
          const b = parseFloat(profParts[3]) || 100;
          const tw = parseFloat(profParts[4]) || 5.5;
          const tf = parseFloat(profParts[5]) || 8;

          // Parse nilai mutu baja: fy | gradeName
          const gradeParts = String(elGrade.value).split('|');
          const fy = parseFloat(gradeParts[0]) || 240;
          const gradeName = gradeParts[1] || 'BJ-37';

          // Parse Momen Rencana Mu & Panjang L
          const mu = Math.max(0, parseFloat(String(elMu.value).replace(',', '.')) || 0);
          const spanL = Math.max(0.1, parseFloat(String(elSpan.value).replace(',', '.')) || 6);

          // Rumus SNI 1729:2020 Bab F (Kuat lentur plastis dengan faktor reduksi phi_b = 0.90)
          // Mn = fy * Zx (N.mm -> kNm dibagi 10^6, karena Zx dalam cm^3 = 10^3 mm^3, maka dibagi 1000)
          const phiB = 0.90;
          const phiMn = (phiB * fy * zx) / 1000;
          const dcRatio = phiMn > 0 ? mu / phiMn : 0;
          const totalMass = unitWeight * spanL;
          const pctUsed = Math.round(dcRatio * 100);

          // Update Judul & Catatan Kaki sesuai mutu baja
          elHeaderTitle.textContent = `Mini Kalkulator Balok WF (${gradeName})`;
          elFootnote.innerHTML = `Simulasi menggunakan mutu baja ${gradeName} (f<sub>y</sub> = ${fy} MPa, &phi;<sub>b</sub> = 0,90) dengan asumsi pengekang lateral penuh. Di dalam suite lengkap <strong>STEELPRO SNI</strong>, perhitungan mencakup panjang tak terkekang (L<sub>b</sub>), geser, serta lendutan izin.`;

          // Update Angka Hasil
          elRatio.textContent = formatID(dcRatio);
          elPhiMn.textContent = `${formatID(phiMn)} kNm`;
          elMass.textContent = `${formatID(totalMass)} kg`;
          elPctBadge.textContent = `${pctUsed}% Terpakai`;

          // Update Progress Bar
          const clampedPct = Math.min(100, Math.max(0, pctUsed));
          elProgressBar.style.width = `${clampedPct}%`;

          // Update Kotak Status SAFE / UNSAFE
          if (dcRatio <= 1.0) {
            elRatio.className = 'font-mono text-3xl sm:text-4xl font-bold text-blue-400 tracking-tight';
            elProgressBar.className = 'h-full bg-emerald-400 rounded-full transition-all duration-300';
            elPctBadge.className = 'font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-400/20';

            elStatBox.className = 'rounded-xl p-3.5 sm:p-4 bg-emerald-100 border border-emerald-300 transition-colors duration-200';
            elStatTxt.className = 'text-xs sm:text-[13px] font-bold text-emerald-950 leading-relaxed';
            elStatTxt.textContent = `STATUS: SAFE / OK (${pctUsed}% kapasitas terpakai). Profil memenuhi syarat lentur.`;
          } else {
            elRatio.className = 'font-mono text-3xl sm:text-4xl font-bold text-red-400 tracking-tight';
            elProgressBar.className = 'h-full bg-red-500 rounded-full transition-all duration-300';
            elPctBadge.className = 'font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-red-500/20 text-red-300 border border-red-400/20';

            elStatBox.className = 'rounded-xl p-3.5 sm:p-4 bg-red-100 border border-red-300 transition-colors duration-200';
            elStatTxt.className = 'text-xs sm:text-[13px] font-bold text-red-950 leading-relaxed';
            elStatTxt.textContent = `STATUS: UNSAFE / NOT OK (${pctUsed}% kapasitas). Profil tidak kuat, silakan perbesar ukuran profil WF.`;
          }

          // Update Detail Penampang & Skala Visual SVG
          const twStr = String(tw).replace('.', ',');
          const tfStr = String(tf).replace('.', ',');
          elDimTitle.textContent = `WF ${h} × ${b} × ${twStr} × ${tfStr} mm`;
          elDimSpecs.innerHTML = `H = ${h} mm · B = ${b} mm · t<sub>w</sub> = ${twStr} mm · t<sub>f</sub> = ${tfStr} mm · Z<sub>x</sub> = ${zx} cm³`;

          // Proporsi dinamis penampang SVG WF
          const scaleFactor = Math.min(1.15, Math.max(0.75, h / 250));
          const halfW = Math.round(22 * scaleFactor);
          const xLeft = 50 - halfW;
          const xRight = 50 + halfW;
          const flangeThick = Math.max(6, Math.round(tf * 0.75));
          const webHalf = Math.max(3, Math.round(tw * 0.55));
          elWfPath.setAttribute(
            'd',
            `M${xLeft} 14 H${xRight} V${14 + flangeThick} H${50 + webHalf} V${86 - flangeThick} H${xRight} V86 H${xLeft} V${86 - flangeThick} H${50 - webHalf} V${14 + flangeThick} H${xLeft} Z`
          );
        } catch (err) {
          console.error('Terjadi kesalahan perhitungan:', err);
        }
      }

      // Event Listeners untuk perubahan real-time
      ['input', 'change'].forEach((evt) => {
        elProf.addEventListener(evt, calculateBeam);
        elGrade.addEventListener(evt, calculateBeam);
        elMu.addEventListener(evt, calculateBeam);
        elSpan.addEventListener(evt, calculateBeam);
      });

      // Tombol Reset ke nilai default
      elReset.addEventListener('click', () => {
        elProf.value = '196|21.3|200|100|5.5|8';
        elGrade.value = '240|BJ-37';
        elMu.value = '32';
        elSpan.value = '6';
        calculateBeam();
      });

      // Kontrol Modal Info Paket Lengkap
      const modal = document.getElementById('paketModal');
      const openBtn = document.getElementById('openInfoModalBtn');
      const closeBtn1 = document.getElementById('closeModalBtn');
      const closeBtn2 = document.getElementById('closeModalBtn2');

      function toggleModal(show) {
        if (show) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        } else {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }

      openBtn.addEventListener('click', () => toggleModal(true));
      closeBtn1.addEventListener('click', () => toggleModal(false));
      closeBtn2.addEventListener('click', () => toggleModal(false));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) toggleModal(false);
      });

      // Jalankan perhitungan awal saat halaman dimuat
      calculateBeam();
    })();
  </script>
</body>
</html>